// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String
  role      String   @default("user")
  operations  Operation[]
  userModules UserModule[]
  sharedRules SharedRule[]
  passwordToken   String?
  tokenSentAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model SharedRule {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  ruleText    String   @db.Text
  isAdvanced  Boolean  @default(false)
  usageCount  Int      @default(0)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Operation {
  id            Int      @id @default(autoincrement())
  operationId   String
  account       String
  operationDate DateTime
  deposit       Float
  result        Float
  outcome       String?  @db.VarChar(10) // "won" | "lost", from the profit sign
  userId        Int
  user          User     @relation(fields: [userId], references: [id])

  // Deriv contract details (nullable: rows saved before these columns existed lack them)
  contractId     String?   @unique @db.VarChar(32)
  transactionId  String?   @db.VarChar(32)
  derivAccountId String?   @db.VarChar(32)
  symbol         String?   @db.VarChar(32)
  contractType   String?   @db.VarChar(32)
  barrier        String?   @db.VarChar(32)
  payout         Float?
  currency       String?   @db.VarChar(10)
  entrySpot      String?   @db.VarChar(32)
  exitSpot       String?   @db.VarChar(32)
  exitDigit      Int?
  purchaseTime   DateTime?
  expiryTime     DateTime?
  shortcode      String?   @db.VarChar(255)
  audit          Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Module {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  userModules UserModule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserModule {
  id       Int     @id @default(autoincrement())
  userId   Int
  moduleId Int
  isActive Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
}
